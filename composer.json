{
    "name": "jp3cki/yii2-jp-postalcode-validator",
    "description": "Postal code validator for Yii Framework2",
    "license": "MIT",
    "type": "yii2-extension",
    "keywords": [
        "yii2",
        "extension",
        "validator",
        "postalcode",
        "zipcode",
        "japan"
    ],
    "authors": [
        {
            "name": "AIZAWA Hina",
            "email": "hina@fetus.jp"
        }
    ],
    "require": {
        "php": ">= 8.3.0",
        "ext-json": "*",
        "ext-pcre": "*",
        "ext-zlib": "*",
        "symfony/polyfill-php84": "^1.43.0",
        "yiisoft/yii2": "~2.0.55"
    },
    "require-dev": {
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-zip": "*",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
        "ergebnis/composer-normalize": "^2.57.0",
        "jp3cki/coding-standard": "^2.0.0",
        "mspirkov/yii2-phpstan": "^0.17.0",
        "php-curl-class/php-curl-class": "^13.0.2",
        "phpunit/phpunit": "^12.5.44",
        "squizlabs/php_codesniffer": "^4.0.4"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "autoload": {
        "psr-4": {
            "jp3cki\\yii2\\jppostalcode\\": "src",
            "jp3cki\\yii2\\jppostalcode\\test\\": "test/src"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "yiisoft/yii2-composer": true
        },
        "platform": {
            "php": "8.3.36"
        },
        "sort-packages": true
    },
    "extra": {
        "bootstrap": "jp3cki\\yii2\\jppostalcode\\internal\\PostalCodeBootstrap"
    }
}
